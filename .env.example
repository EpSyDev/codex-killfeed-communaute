# ─────────────────────────────────────────────────────────────────────────────
# CodeX KillFeed — configuration
# Copie ce fichier en « .env » puis remplis les 3 valeurs obligatoires.
# Ne partage JAMAIS ton .env : il contient tes tokens.
# ─────────────────────────────────────────────────────────────────────────────

# Token du bot Discord (Discord Developer Portal → ton application → Bot → Reset Token)
DISCORD_TOKEN=

# Token API Nitrado long-life (nitrado.net → Mon compte → Developer → Long-life tokens)
NITRADO_TOKEN=

# ID de SERVICE Nitrado : le nombre dans l'URL de ton serveur
# ex. https://server.nitrado.net/fr-FR/services/17661226/... → 17661226
NITRADO_SERVER_ID=

# ── Optionnel ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# CODEX_DB_PATH=/opt/codex-killfeed/codex-kit.db
# CODEX_DATA_DIR=/opt/codex-killfeed/data
